# Variables PÚBLICAS del frontend (se incrustan en el bundle; nunca pongas secretos aquí).
# Modo demo: muestra datos ficticios etiquetados como DEMO. Debe ser "false" en producción.
VITE_DEMO_MODE=true
# Fase 2+: URL pública del proyecto Supabase y clave "anon"/publishable (pública por diseño, protegida por RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
# Fase 3+: site key pública de Turnstile.
VITE_TURNSTILE_SITE_KEY=placeholder-site-key
